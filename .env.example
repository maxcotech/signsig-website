# Copy to .env.local and adjust. .env.local is gitignored.

# Absolute origin of the deployed site, no trailing slash.
# Drives metadataBase, canonical URLs, OG image URLs and the sitemap.
# If this is wrong in production, every one of those is silently wrong
# and nothing visibly breaks until launch.
NEXT_PUBLIC_SITE_URL=https://signsig.com

# Local development (the built-in fallback when the var is unset):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The SignSig business app — where "Get Started" sends a visitor to sign up
# and actually use the product, as opposed to this marketing site. Every
# "Get Started" CTA reads this at build/runtime via getBusinessAppUrl(), so
# one value here (or in CI/CD's environment for the target deployment)
# repoints every one of them at once.
NEXT_PUBLIC_BUSINESS_APP_URL=https://signsig-business-dev.netlify.app

# Backend API origin — the same backend the business app (signsig-web) talks
# to, not this site's own Next.js server. Every src/lib/api/ call reads this
# via getApiBaseUrl(). Unset by default: there is no marketing-site feature
# that calls it yet, and a guessed fallback here would fail silently against
# the wrong backend instead of failing loudly. Uncomment when a real
# integration needs it — see docs/API.md.
# NEXT_PUBLIC_API_BASE_URL=https://signsig-business.intbithq.com/api
